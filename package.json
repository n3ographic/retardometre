    "build:vitesses": "tsx scripts/build-vitesses.ts",
    "test:perf": "PERF=1 vitest run tests/api-perf.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "csv-parse": "7.0.3",
    "fflate": "0.8.3",
    "gtfs-realtime-bindings": "1.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.2.17",
    "@types/node": "24.0.0",
    "tsx": "4.23.15",
    "typescript": "5.6.2",
    "vitest": "4.1.12"
  }
}
